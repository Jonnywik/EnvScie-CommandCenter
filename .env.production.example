# Copy to .env.production and inject actual secret values through your approved secret manager.
# Never commit .env.production or replace blanks with placeholder values in a production deployment.

POSTGRES_DB=cfr
POSTGRES_USER=cfr_app
POSTGRES_PASSWORD=

# Supply the complete final DSN through the approved secret manager. Do not rely on nested interpolation here.
DATABASE_URL=
DEMO_MODE=false
ENVIRONMENT=production
CORS_ORIGINS=https://command-center.example.gov.ph

AUTH_SECRET=
SMS_GATEWAY_SHARED_SECRET=
ALERT_FEED_URL=
ALERT_FEED_SOURCE_NAME=PAGASA
ALERT_FEED_TIMEOUT_SECONDS=8
ALERT_STALE_AFTER_SECONDS=900
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=BALANGIGA-DRRM
PUSH_PROVIDER_URL=
PUSH_PROVIDER_API_KEY=
NOTIFICATION_RETRY_MAX=3

# Internal-only service target; do not make the API publicly reachable unless a reviewed gateway is in front of it.
API_PROXY_TARGET=http://api:8000
