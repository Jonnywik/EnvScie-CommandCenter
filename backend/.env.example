ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://cfr:cfr@localhost:5432/cfr
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true
# Replace with a real provider/gateway secret before enabling SMS intake.
SMS_GATEWAY_SHARED_SECRET=replace-with-secret-manager-value
SMS_MAX_AGE_SECONDS=86400
# Use a long random value outside demo mode; do not commit real secrets.
AUTH_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=28800
ALERT_FEED_TIMEOUT_SECONDS=8
ALERT_STALE_AFTER_SECONDS=900
# Configure only after an approved source adapter and source contract exist.
ALERT_FEED_URL=
ALERT_FEED_SOURCE_NAME=PAGASA
# Assignment notification delivery. Keep provider credentials in a secret manager.
# Demo mode simulates SMS and in-app delivery without calling external services.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=BALANGIGA-DRRM
PUSH_PROVIDER_URL=
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_DEMO_DELAY_SECONDS=2
